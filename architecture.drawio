        <mxCell id="note1" value="Note: apps/api runs as a native long-lived process (needs live git/docker/claude-CLI access a container lacks) -- it is NOT rebuilt by the deploy pipeline's docker compose step, unlike web." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#990000;" vertex="1" parent="1">

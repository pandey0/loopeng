<mxfile host="app.diagrams.net">
  <diagram name="loopeng architecture" id="loopeng-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1275" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Infra layer -->
        <mxCell id="infra_pg" value="postgres:16-alpine&#10;(port 5433)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="infra_redis" value="Redis (optional)&#10;BullMQ queue backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="infra_claude" value="claude CLI&#10;(spawned subprocess per agent run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="infra_git" value="wiki-repo / worktrees&#10;(git-backed, on disk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="infra_docker" value="docker compose&#10;(web container only -- api runs native)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="40" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- Apps layer -->
        <mxCell id="app_web" value="apps/web&#10;Next.js 15 (port 3000, containerized)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="160" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="app_api" value="apps/api&#10;Fastify + WS (port 4000, native long-lived process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="160" width="280" height="60" as="geometry" />

# Full-access Postgres credential -- only ever meant for the API/orchestrator
# process itself (and local dev/test iteration, same as any other local
# database). Card 438646e5: every process the orchestrator spawns inside an
# agent's own worktree (the top-level `claude` CLI, and its own sub-agent MCP
# server subprocess) has this stripped from its env before spawn (see
# AGENT_ENV_DENYLIST in packages/agents/src/claude-cli.ts) -- state mutations
# from inside a worktree happen only through the authenticated API
# (CARD_API_KEY/CARD_API_URL, minted per run), never a direct DB connection.
# @loopeng/db (packages/db/src/client.ts) also has no hardcoded fallback of
# its own, so an unset DATABASE_URL fails loud instead of silently
# reconnecting to a credential baked into source.
# The value below is a fixed local-dev default matching docker-compose's own
# default (${DB_PASSWORD:-loopeng}) -- fine for local iteration, but "the one
# real instance" (infrastructure/docker/docker-compose.yml) should have
# DB_PASSWORD set to a real generated secret via infrastructure/docker/.env
# (gitignored, never committed), same as WEB_API_KEY below, so this file
# never reflects the actual production credential.
DATABASE_URL=postgresql://loopeng:loopeng@localhost:5433/loopeng
DB_PORT=5433
WIKI_REPO_PATH=/data/wiki-repo
WORKTREES_PATH=/data/worktrees
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shared secret that lets the API tell a browser-originated (human) request
# apart from anything else hitting it -- see ensureStaticApiKey in
# @loopeng/db. Never set this in an agent worktree's env; it must only ever
# reach the web app. Generate a real random value per deployment, e.g.
# `openssl rand -base64 32`.
WEB_API_KEY=change-me-web-api-key
# Baked into the web app's client bundle at build time (same mechanism as
# NEXT_PUBLIC_API_URL) so the browser can send it -- must match WEB_API_KEY
# above exactly.
NEXT_PUBLIC_WEB_API_KEY=change-me-web-api-key

# Leave unset for any worktree-local/dev copy of apps/api. Only the one real
# instance (see infrastructure/docker/docker-compose.yml) should set this to
# "1" -- it turns on cron/event dispatch, which starts a second orchestrator
# racing the real one over the same DATABASE_URL if set anywhere else.
# ORCHESTRATOR_ENABLED=1

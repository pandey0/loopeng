{
  "name": "@loopeng/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '**/data/**' --exclude '**/node_modules/**' src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.2.0",
    "@loopeng/agents": "workspace:*",
    "@loopeng/board-engine": "workspace:*",
    "@loopeng/db": "workspace:*",
    "@loopeng/doc-engine": "workspace:*",
    "@loopeng/orchestrator": "workspace:*",
    "@loopeng/shared": "workspace:*",
    "@loopeng/worktree-manager": "workspace:*",
    "drizzle-orm": "^0.36.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "simple-git": "^3.27.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6",
    "ws": "^8.18.0"
  }
}
